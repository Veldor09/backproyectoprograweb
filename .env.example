# ─────────────────────────────────────────────────────────────
# Force Extreme — Backend (NestJS) — Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# ─────────────────────────────────────────────────────────────

# Conexión a PostgreSQL.
# Desarrollo local (docker-compose.dev.yml expone el puerto 5433):
DATABASE_URL="postgresql://forceextreme:forceextreme@localhost:5433/forceextreme?schema=public"
# Producción (Render / Neon / Supabase): usa la URL que te da el proveedor.
# Para Render Postgres usa la "Internal Database URL".

# Secreto para firmar los JWT. En producción usa un valor largo y aleatorio.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Puerto del servidor (Render inyecta PORT automáticamente).
PORT=4000

# Origen(es) permitidos para CORS. Acepta varios separados por coma.
# Ej: https://force-extreme.vercel.app,https://www.forceextreme.com
FRONTEND_URL="http://localhost:3000"

# Entorno: "development" o "production".
NODE_ENV="development"

# Pon "false" para ocultar la documentación Swagger en /api/docs.
SWAGGER_ENABLED="true"

# ── Email (SMTP / Gmail) ──────────────────────────────────────
# Sin estas variables los emails solo aparecen en los logs (modo desarrollo).
#
# === Opción recomendada: Gmail SMTP ===
# 1. Activa la verificación en 2 pasos en tu cuenta Google.
# 2. Ve a: Cuenta de Google → Seguridad → Contraseñas de aplicación.
# 3. Crea una contraseña para "Correo" y cópiala aquí (16 caracteres sin espacios).
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=abcdabcdabcdabcd

# Nombre y dirección que verán los destinatarios.
EMAIL_FROM="Force Extreme <tucorreo@gmail.com>"
